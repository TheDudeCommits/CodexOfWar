{
  "name": "gauntlet-loop-web-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "build:critic": "npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/simulation",
    "test:critic": "vitest run tests/simulation tests/camera tests/pose tests/diagnostics",
    "test:camera": "vitest run tests/camera",
    "test:watch": "vitest tests/simulation",
    "smoke": "playwright test",
    "serve:critic": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/three": "0.185.3",
    "eslint": "9.39.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "3.2.7"
  }
}
