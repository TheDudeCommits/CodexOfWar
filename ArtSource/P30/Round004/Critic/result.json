    "characterAnatomySilhouette": {"score": 3, "max": 10, "deduction": "Toy-like anatomy, small gameplay scale, and merged hero/Hollow silhouettes in S02-S05; S06 reads as a toppled ragdoll."},
    "skinHairClothArmorMaterialFidelity": {"score": 2, "max": 10, "deduction": "Flat plastic color blocks, chunky hair, and little skin, cloth, leather, or armor micro-surface differentiation."},
    "enemyZombieThreatFidelity": {"score": 2, "max": 10, "deduction": "The Hollow is a simplified cartoon skull figure and never attacks; the 30-second combat interval left player health at 100 while the enemy only idled, reacted, and died."},
    "weaponQualityHandContactReadability": {"score": 3, "max": 10, "deduction": "The blade is readable in S01-S04 but collapses edge-on/behind the actors in S05 and crosses the body/ground in S06; stable visible palm contact is not maintained."},
    "animationPosingWeightContact": {"score": 2, "max": 10, "deduction": "Required clips run, but attack startup, active, and recovery lack weight and spacing; actors intersect at contact and the roll pose looks ungrounded."},
    "combatVfxImpactPhysicsReadability": {"score": 3, "max": 10, "deduction": "Health, hit reaction, sparks, and a toast register, but the large flat cyan fan and intersecting bodies do not communicate a physical weapon impact."},
    "cameraFramingComposition": {"score": 3, "max": 10, "deduction": "Actors are tiny against empty ground, combat silhouettes overlap, boom obstruction is unimplemented, and camera replay hashes differ after reset."},
    "environmentLightingIntegration": {"score": 5, "max": 10, "deduction": "The PBR fort and cobbles are coherent, but the arena remains an empty plane against a dark void and characters look weakly integrated with the lighting."},
    "uiCinematicCoherence": {"score": 5, "max": 10, "deduction": "The sparse HUD is legible, but the persistent controls strip and floating REND toast feel prototype-level and the presentation has no cinematic combat emphasis."},
    "runtimePolishStabilityPerformance": {"score": 6, "max": 10, "deduction": "Cold ready, 60 fps behavior, input, resize, and context restore are good; every capture exceeds the triangle ceiling, full camera replay is not exact, obstruction is pending, and three deprecation warnings recur."}
